#!/usr/bin/env bash
set -Eeuo pipefail

docker compose exec -T iris iris session IRIS -U CCWDEMO <<'OBJECTSCRIPT'
set ^UnitTestRoot="/workspace/packages/cube-cache-warmer/tests"
set sc=##class(%UnitTest.Manager).RunTest("dc/bi/CubeCacheWarmer/Test","/loadud")
if $SYSTEM.Status.IsError(sc) { do $SYSTEM.OBJ.DisplayError(sc) do ##class(%SYSTEM.Process).Terminate(,1) }
set ^UnitTestRoot="/workspace/tests"
set sc=##class(%UnitTest.Manager).RunTest("Demo/Test","/loadud")
if $SYSTEM.Status.IsError(sc) { do $SYSTEM.OBJ.DisplayError(sc) do ##class(%SYSTEM.Process).Terminate(,1) }
halt
OBJECTSCRIPT
